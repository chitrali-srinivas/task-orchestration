# Copy to web/.env.local (git-ignored) and fill in.
# NEXT_PUBLIC_* values are built into the browser bundle: restart `npx next dev` after changing them, and pass them
# as Docker build arguments for Cloud Run (see the README's Environment section).

# Required for maps (Task planning job map; also the Deployment and Map view pages).
# Google Cloud: enable "Maps JavaScript API" for this key and restrict it to your site addresses
# (http://localhost:3100/* and the Cloud Run URL).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Road routes in the Task planning job workspace (server-only: no NEXT_PUBLIC_ prefix, never sent to the browser).
# Google Cloud: enable the "Routes API" and restrict this key to it. Used by web/src/app/api/routes/compute/route.ts.
# Read at request time, so it's a runtime variable (Cloud Run: set it on the service, ideally from Secret Manager).
# Without it the workspace shows straight lines and estimated drive times.
GOOGLE_ROUTES_API_KEY=
